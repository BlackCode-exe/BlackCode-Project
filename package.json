{
  "name": "blackcode-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/gen-asset-version.js && esbuild src/index.js --bundle --outfile=dist/index.js --format=esm --target=es2022 --minify",
    "dev": "npm run build && wrangler dev dist/index.js",
    "deploy": "npm run build && wrangler deploy dist/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.113.0"
  }
}
